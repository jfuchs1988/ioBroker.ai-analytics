{
  "type": "tabs",
  "items": {
    "settingsTab": {
      "type": "panel",
      "label": "Einstellungen",
      "items": {
    "chatModelHeader": {
      "type": "header",
      "text": "Chat- und Prüfungsmodell",
      "size": 3
    },
    "providerType": {
      "type": "select",
      "label": "LLM-Provider",
      "options": [
        { "label": "Anthropic", "value": "anthropic" },
        { "label": "OpenAI", "value": "openai" },
        { "label": "OpenRouter", "value": "openrouter" },
        { "label": "Lokal (OpenAI-kompatibel)", "value": "local" }
      ]
    },
    "apiKey": {
      "type": "password",
      "label": "API-Key"
    },
    "model": {
      "type": "autocompleteSendTo",
      "label": "Modell (OpenRouter zeigt kostenlose Tool-Modelle)",
      "command": "listProviderModels",
      "jsonData": "{\"providerType\":\"${data.providerType}\",\"apiKey\":\"${data.apiKey}\",\"baseUrl\":\"${data.baseUrl}\"}",
      "alsoDependsOn": ["providerType", "apiKey", "baseUrl"],
      "freeSolo": true
    },
    "baseUrl": {
      "type": "text",
      "label": "Basis-URL (nur fuer OpenRouter/Lokal)"
    },
    "chatPricePerMillionInputTokens": {
      "type": "number",
      "label": "Preis pro 1 Mio. Input-Tokens (Chat, z.B. USD)",
      "default": 0,
      "min": 0
    },
    "chatPricePerMillionOutputTokens": {
      "type": "number",
      "label": "Preis pro 1 Mio. Output-Tokens (Chat, z.B. USD)",
      "default": 0,
      "min": 0
    },
    "chatModelDivider1": {
      "type": "divider"
    },
    "openRouterSignup": {
      "type": "staticLink",
      "label": "OpenRouter API-Key erstellen (empfohlen fuer automatisch erkannte kostenlose Tool-Modelle)",
      "href": "https://openrouter.ai/settings/keys",
      "button": true,
      "variant": "outlined"
    },
    "openCodeZenSignup": {
      "type": "staticLink",
      "label": "OpenCode Zen ansehen (alternative, teilweise zeitlich begrenzt kostenlose API)",
      "href": "https://opencode.ai/auth",
      "button": true,
      "variant": "text"
    },
    "chatModelDivider2": {
      "type": "divider"
    },
    "onboardingHeader": {
      "type": "header",
      "text": "Onboarding-Modell (optional, sonst wie oben)"
    },
    "onboardingProviderType": {
      "type": "select",
      "label": "LLM-Provider (Onboarding)",
      "options": [
        { "label": "Wie oben (Chat/Pruefung)", "value": "" },
        { "label": "Anthropic", "value": "anthropic" },
        { "label": "OpenAI", "value": "openai" },
        { "label": "OpenRouter", "value": "openrouter" },
        { "label": "Lokal (OpenAI-kompatibel)", "value": "local" }
      ]
    },
    "onboardingApiKey": {
      "type": "password",
      "label": "API-Key (Onboarding)"
    },
    "onboardingModel": {
      "type": "autocompleteSendTo",
      "label": "Modell (Onboarding; OpenRouter zeigt kostenlose Tool-Modelle)",
      "command": "listProviderModels",
      "jsonData": "{\"providerType\":\"${data.onboardingProviderType}\",\"apiKey\":\"${data.onboardingApiKey}\",\"baseUrl\":\"${data.onboardingBaseUrl}\"}",
      "alsoDependsOn": ["onboardingProviderType", "onboardingApiKey", "onboardingBaseUrl"],
      "freeSolo": true
    },
    "onboardingBaseUrl": {
      "type": "text",
      "label": "Basis-URL (Onboarding, nur fuer OpenRouter/Lokal)"
    },
    "onboardingPricePerMillionInputTokens": {
      "type": "number",
      "label": "Preis pro 1 Mio. Input-Tokens (Onboarding, z.B. USD)",
      "default": 0,
      "min": 0
    },
    "onboardingPricePerMillionOutputTokens": {
      "type": "number",
      "label": "Preis pro 1 Mio. Output-Tokens (Onboarding, z.B. USD)",
      "default": 0,
      "min": 0
    },
    "onboardingDivider": {
      "type": "divider"
    },
    "operationsHeader": {
      "type": "header",
      "text": "Betrieb: Proaktive Prüfung & Budget",
      "size": 3
    },
    "checkIntervalHours": {
      "type": "number",
      "label": "Intervall proaktive Pruefung (Stunden)",
      "default": 24,
      "min": 1
    },
    "silentIfNothingFound": {
      "type": "checkbox",
      "label": "Bei keinem Fund keine Nachricht senden",
      "default": false
    },
    "dailyTokenBudget": {
      "type": "number",
      "label": "Taegliches Token-Budget (0 = kein Limit)",
      "default": 0,
      "min": 0
    },
    "enableValueKindBackfill": {
      "type": "checkbox",
      "label": "Bestehende Datenpunkte nachtraeglich auf Auspraegung (valueKind) pruefen",
      "default": false
    },
    "budgetSummary": {
      "type": "state",
      "oid": "usage.todaySummary",
      "control": "text",
      "readOnly": true,
      "label": "Aktuelles Budget (heute)"
    },
    "operationsDivider": {
      "type": "divider"
    },
    "sponsorLink": {
      "type": "staticLink",
      "label": "Projekt ueber GitHub Sponsors unterstuetzen",
      "href": "https://github.com/sponsors/jfuchs1988",
      "button": true,
      "variant": "contained",
      "color": "primary"
    }
      }
    },
    "devicesTab": {
      "type": "panel",
      "label": "Geräte",
      "items": {
        "devicesHint": {
          "type": "staticText",
          "text": "Hier werden alle historisierten und katalogisierten Datenpunkte verwaltet. Änderungen werden direkt im Katalog gespeichert."
        },
        "devicesSponsorLink": {
          "type": "staticLink",
          "label": "Projekt ueber GitHub Sponsors unterstuetzen",
          "href": "https://github.com/sponsors/jfuchs1988",
          "button": true,
          "variant": "outlined"
        },
        "catalogDevices": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/CatalogDevicesComponent",
          "guiApi": 2,
          "bundlerType": "module"
        }
      }
    }
  }
}
