{
  "type": "tabs",
  "defaultTab": "settingsTab",
  "items": {
    "settingsTab": {
      "type": "panel",
      "label": "Einstellungen",
      "items": {
        "budgetSummary": {
          "type": "state",
          "oid": "usage.todaySummary",
          "control": "text",
          "readOnly": true,
          "label": "Aktuelles Budget (heute)",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
         "sponsorLink": {
          "type": "staticLink",
          "label": "GitHub Sponsors",
          "href": "https://github.com/sponsors/jfuchs1988",
          "button": true,
          "variant": "contained",
          "newLine": true,
          "sm": 12,
          "md": 5,
          "lg": 3,
          "xl": 3
        },
        "settingsCsv": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/SettingsCsvComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "newLine": true,
          "label": "Settings sichern / importieren"
        },
        "topDivider": {
          "type": "divider",
          "newLine": true
        },
        "chatModelHeader": {
          "type": "header",
          "text": "Chat- und Prüfungsmodell",
          "size": 3,
          "newLine": true
        },
        "openRouterSignup": {
          "type": "staticLink",
          "label": "OpenRouter API-Key erstellen (kostenlose Tool-Modelle)",
          "href": "https://openrouter.ai/settings/keys",
          "button": true,
          "variant": "outlined",
          "newLine": true,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "openCodeZenSignup": {
          "type": "staticLink",
          "label": "OpenCode Zen ansehen (alternative Gratis-API)",
          "href": "https://opencode.ai/auth",
          "button": true,
          "variant": "text",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "chatModelDivider": {
          "type": "divider",
          "newLine": true
        },
        "providerType": {
          "type": "custom",
          "urlField": "baseUrl",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/ProviderSelectComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "label": "LLM-Provider",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "baseUrl": {
          "type": "text",
          "label": "Basis-URL (nur fuer OpenRouter/OpenCode/Lokal)",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "model": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/ModelSelectComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "label": "Modell",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "apiKey": {
          "type": "password",
          "label": "API-Key",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "chatPricePerMillionInputTokens": {
          "type": "number",
          "label": "Preis pro 1 Mio. Input-Tokens (Chat, z.B. USD)",
          "default": 0,
          "min": 0,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "chatPricePerMillionOutputTokens": {
          "type": "number",
          "label": "Preis pro 1 Mio. Output-Tokens (Chat, z.B. USD)",
          "default": 0,
          "min": 0,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "onboardingDivider": {
          "type": "divider",
          "newLine": true
        },
        "onboardingHeader": {
          "type": "header",
          "text": "Onboarding-Modell (optional, sonst wie oben)",
          "size": 3,
          "newLine": true
        },
        "onboardingProviderType": {
          "type": "custom",
          "includeEmpty": true,
          "urlField": "onboardingBaseUrl",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/ProviderSelectComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "label": "LLM-Provider (Onboarding)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "onboardingBaseUrl": {
          "type": "text",
          "label": "Basis-URL (Onboarding, nur fuer OpenRouter/OpenCode/Lokal)",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "onboardingModel": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/ModelSelectComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "label": "Modell (Onboarding)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "onboardingApiKey": {
          "type": "password",
          "label": "API-Key (Onboarding)",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "onboardingPricePerMillionInputTokens": {
          "type": "number",
          "label": "Preis pro 1 Mio. Input-Tokens (Onboarding, z.B. USD)",
          "default": 0,
          "min": 0,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "onboardingPricePerMillionOutputTokens": {
          "type": "number",
          "label": "Preis pro 1 Mio. Output-Tokens (Onboarding, z.B. USD)",
          "default": 0,
          "min": 0,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "operationsDivider": {
          "type": "divider",
          "newLine": true
        },
        "operationsHeader": {
          "type": "header",
          "text": "Betrieb: Proaktive Prüfung & Budget",
          "size": 3,
          "newLine": true
        },
        "checkIntervalHours": {
          "type": "number",
          "label": "Intervall proaktive Pruefung (Stunden)",
          "default": 24,
          "min": 1,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "dailyBudgetEur": {
          "type": "number",
          "label": "Taegliches Budget (EUR, 0 = kein Limit)",
          "help": "Wird nur ausgewertet, wenn fuer Chat oder Onboarding ein Preis pro 1 Mio. Tokens eingetragen ist.",
          "default": 0,
          "min": 0,
          "validator": "data.dailyBudgetEur <= 0 || Number(data.chatPricePerMillionInputTokens) > 0 || Number(data.chatPricePerMillionOutputTokens) > 0 || Number(data.onboardingPricePerMillionInputTokens) > 0 || Number(data.onboardingPricePerMillionOutputTokens) > 0",
          "validatorErrorText": "Kein Preis pro Token eingetragen: Ohne Preis kann kein Budget in EUR ausgewertet werden.",
          "validatorNoSaveOnError": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "usageReset": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/UsageResetComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "label": "Tokenzähler",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "maxAgentIterations": {
          "type": "number",
          "label": "Maximale KI-Schritte pro Anfrage (1-32)",
          "default": 8,
          "min": 1,
          "max": 32,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "maxToolCalls": {
          "type": "number",
          "label": "Maximale Werkzeug-Aufrufe (1-128)",
          "default": 32,
          "min": 1,
          "max": 128,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "maxPeriodsPerRequest": {
          "type": "number",
          "label": "Maximale Zeiträume pro Anfrage (1-1024)",
          "default": 256,
          "min": 1,
          "max": 1024,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "maxPeriodsPerToolCall": {
          "type": "number",
          "label": "Maximale Zeiträume je Werkzeug (1-120)",
          "default": 72,
          "min": 1,
          "max": 120,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 2,
          "xl": 2
        },
        "licenseToken": {
          "type": "password",
          "label": "Sponsoring-Entitlement-Token (ab Version 0.1.0)",
          "help": "Token aus der Sponsoring-Webanwendung hier einfügen. Beta-Versionen benötigen kein Token.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "silentIfNothingFound": {
          "type": "checkbox",
          "label": "Bei keinem Fund keine Nachricht senden",
          "default": false,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "enableValueKindBackfill": {
          "type": "checkbox",
          "label": "Bestehende Datenpunkte nachtraeglich auf Auspraegung (valueKind) pruefen",
          "default": false,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "enableDataQualityBackfill": {
          "type": "checkbox",
          "label": "Bestehende Datenpunkte nachtraeglich auf Schreibbarkeit/Update-Frequenz/Vollstaendigkeit pruefen",
          "default": false,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        }
      }
    },
    "catalogTab": {
      "type": "panel",
      "label": "Historisierte Datenpunkte",
      "items": {
        "catalogHeader": {
          "type": "header",
          "text": "Historisierte Datenpunkte",
          "size": 3,
          "newLine": true
        },
        "catalogHint": {
          "type": "staticText",
          "text": "Datenpunkte auswählen, Änderungen vornehmen und anschließend einmal speichern. Räume sind freie Eingaben, zum Beispiel Keller, Heizraum, Technikraum oder Garage.",
          "newLine": true
        },
        "catalogDevices": {
          "type": "custom",
          "url": "custom/customComponents.js",
          "name": "AiAnalyticsConfig/Components/CatalogDevicesComponent",
          "guiApi": 2,
          "bundlerType": "module",
          "newLine": true
        }
      }
    }
  }
}
